      <!-- Зашифрованные заметки (декоративные) -->
      <article class="post reveal">
        <span class="post-date">19 января, 2026</span>
        <h2>🔒 Личные заметки</h2>
        <div style="background: rgba(196, 30, 58, 0.1); padding: 1rem; border-radius: 12px; font-family: monospace;">
          <p>• АПЕЛЬСИН-САЦЬНВЩЮ-17</p>
          <p>• АБРИКОС-ЫЬЛГЕЙМ-27</p>
