      <!-- 16 марта 2026 -->
      <article class="post reveal" id="ml">
        <span class="post-date">16 марта, 2026</span>
        <h2>📊 Прогноз успеваемости студентов</h2>
        <div class="code-block">
new_student = pd.DataFrame({'Часы': [5]})
prediction = regressor.predict(new_student)
print(f"Студент занимался 5 часов")
print(f"Прогноз баллов: {prediction[0]:.2f}")

# Группа студентов
students = pd.DataFrame({'Часы': [1, 3, 5, 7, 10]})
predictions = regressor.predict(students)

results = pd.DataFrame({
    'Часы подготовки': students['Часы'],
    'Прогноз баллов': predictions
})
print(results)
        </div>
        <div class="data-block">
          <table style="width:100%; border-collapse: collapse; margin-top: 0.5rem;">
            <thead>
              <tr style="border-bottom: 2px solid var(--red-primary);">
                <th style="text-align: left; padding: 0.5rem;">Часы подготовки</th>
                <th style="text-align: left; padding: 0.5rem;">Прогноз баллов</th>
              </tr>
            </thead>
            <tbody>
              <tr><td style="padding: 0.4rem 0.5rem;">1</td><td>12.32</td></tr>
              <tr><td style="padding: 0.4rem 0.5rem;">3</td><td>31.28</td></tr>
              <tr><td style="padding: 0.4rem 0.5rem;">5</td><td>50.23</td></tr>
              <tr><td style="padding: 0.4rem 0.5rem;">7</td><td>69.19</td></tr>
              <tr><td style="padding: 0.4rem 0.5rem;">10</td><td>97.62</td></tr>
            </tbody>
          </table>
        </div>
        <div class="tags">
          <span class="tag">#LinearRegression</span>
          <span class="tag">#Python</span>
          <span class="tag">#DataScience</span>
        </div>
      </article>

      <!-- 21 марта 2026 -->
